# Rendered by the vector-config module for {{ HOST }} -- edit the template in the
# homelab repo, not this file. Ships Docker container logs, Traefik access and
# runtime logs, and /var/log/*log to VictoriaLogs on helm.
{%- if SHADOW %}
#
# SHADOW: writes to VictoriaLogs tenant AccountID=1 beside Alloy (homelab-ops#366),
# so Grafana, log-spikes and vmalert (tenant 0) never see these lines twice.
{%- endif %}
{%- if JOURNALD == "shadow" %}
#
# JOURNALD SHADOW: the systemd journal goes to tenant AccountID=1 beside
# journal-upload (homelab-ops#375); Docker and varlogs stay on tenant 0.
{%- endif %}
data_dir: /var/lib/vector
{%- if GEOIP %}

enrichment_tables:
  asn:
    type: geoip
    path: /etc/vector/geoip/GeoLite2-ASN.mmdb
{%- endif %}

sources:
  # docker_logs keeps no checkpoint: lines written while Vector is down are lost
  # (homelab-ops#363). Config changes reload by SIGHUP, which only rebuilds
  # changed components, so a deploy that leaves this source alone keeps it reading.
  docker:
    type: docker_logs
    exclude_containers: [vector-{{ HOST }}]

  varlogs:
    type: file
    include: ["/var/log/*log"]
    # Without this a new host ships the whole history of /var/log on first start.
    read_from: end
{%- if JOURNALD %}

  # Checkpoints in data_dir, advanced only on sink acknowledgement. The wrapper
  # restores the previous boot's tail that systemd 257 skips (homelab-ops#376);
  # current_boot_only stays at its default because `false` fails on 250-257.
  journald:
    type: journald
    journalctl_path: /etc/vector/bin/journalctl-catchup
    # First start ships from now on, like journal-upload's cursor seeding.
    since_now: true
{%- endif %}

  internal:
    type: internal_metrics

transforms:
  # One Docker watcher; Traefik is split out by name, then access vs runtime by
  # the same rule Alloy used: an access line is JSON carrying "ClientHost".
  # The line itself stays raw: VictoriaLogs' Loki endpoint parses JSON into fields.
  docker_shape:
    type: remap
    inputs: [docker]
    source: |
      name = string!(.container_name)
      msg = string(.message) ?? ""
      # Alloy never shipped blank lines; VictoriaLogs would store them as
      # "missing _msg field" (homelab-ops#367).
      if strip_whitespace(msg) == "" {
        abort
      }
      job = "docker"
      if name == "traefik-{{ HOST }}" {
        name = "traefik"
        job = "traefik-runtime"
        if contains(msg, "\"ClientHost\"") {
          job = "traefik-access"
{%- if GEOIP %}
          parsed, err = parse_json(msg)
          if err == null && is_object(parsed) && is_string(parsed.ClientHost) {
            rec, err = get_enrichment_table_record("asn", {"ip": parsed.ClientHost})
            if err == null {
              parsed.geoip_autonomous_system_number = rec.autonomous_system_number
              parsed.geoip_autonomous_system_organization = rec.autonomous_system_organization
              msg = encode_json(parsed)
            }
          }
{%- endif %}
        }
      }
      . = {
        "timestamp": .timestamp,
        "message": msg,
        "job": job,
        "host": "{{ HOST }}",
        "container_name": name,
      }

  varlogs_shape:
    type: remap
    inputs: [varlogs]
    source: |
      . = {
        "timestamp": .timestamp,
        "message": .message,
        "job": "varlogs",
        "host": "{{ HOST }}",
      }
{%- if JOURNALD %}

  # journal-upload's shape (VictoriaLogs' /insert/journald defaults): every journal
  # field, `level` from PRIORITY, no `__*` fields. Vector renames _HOSTNAME to host.
  journald_shape:
    type: remap
    inputs: [journald]
    source: |
      levels = ["emerg", "alert", "critical", "error", "warning", "notice", "info", "debug"]
      level = "info"
      if is_string(.PRIORITY) {
        level = string(get(levels, [parse_int(.PRIORITY) ?? 6]) ?? null) ?? "info"
      }
      # journal-upload's _time is journald's receive time; Vector prefers the sender's.
      received, err = parse_int(.__REALTIME_TIMESTAMP)
      if err == null {
        .timestamp = from_unix_timestamp!(received, unit: "microseconds")
      }
      hostname = del(.host)
      del(.source_type)
      . = filter(.) -> |key, _value| { !starts_with(key, "__") }
      ._HOSTNAME = if is_string(hostname) { hostname } else { "{{ HOST }}" }
      .level = level
{%- endif %}

sinks:
  vlogs_docker:
    type: loki
    inputs: [docker_shape]
    endpoint: http://victoria-logs:9428
    path: /insert/loki/api/v1/push
    encoding:
      codec: text
    labels:
      job: "{% raw %}{{ job }}{% endraw %}"
      host: "{% raw %}{{ host }}{% endraw %}"
      container_name: "{% raw %}{{ container_name }}{% endraw %}"
    remove_label_fields: true
    out_of_order_action: accept
    healthcheck:
      enabled: false
{%- if SHADOW %}
    # The Loki sink ignores request.headers; VictoriaLogs maps X-Scope-OrgID to AccountID.
    tenant_id: "1"
{%- endif %}
    buffer:
      type: disk
      max_size: 268435488
      when_full: block

  # A sink of its own: varlogs has no container_name, and a label template that
  # fails to render counts as a sink error.
  vlogs_varlogs:
    type: loki
    inputs: [varlogs_shape]
    endpoint: http://victoria-logs:9428
    path: /insert/loki/api/v1/push
    encoding:
      codec: text
    labels:
      job: "{% raw %}{{ job }}{% endraw %}"
      host: "{% raw %}{{ host }}{% endraw %}"
    remove_label_fields: true
    out_of_order_action: accept
    healthcheck:
      enabled: false
{%- if SHADOW %}
    tenant_id: "1"
{%- endif %}
    # The file source checkpoints only acknowledged lines; docker_logs cannot ack,
    # so acknowledgements are on here only.
    acknowledgements:
      enabled: true
    buffer:
      type: disk
      max_size: 268435488
      when_full: block
{%- if JOURNALD %}

  # The Elasticsearch endpoint, as on zion, because it takes _stream_fields; the
  # Loki endpoint would make every journal field a label or drop it.
  vlogs_journald:
    type: elasticsearch
    inputs: [journald_shape]
    endpoints: ["http://victoria-logs:9428/insert/elasticsearch/"]
    mode: bulk
    api_version: v8
    compression: gzip
    healthcheck:
      enabled: false
    query:
      _msg_field: message
      _time_field: timestamp
      _stream_fields: _MACHINE_ID,_HOSTNAME,_SYSTEMD_UNIT
{%- if JOURNALD == "shadow" or SHADOW %}
    request:
      headers:
        AccountID: "1"
{%- endif %}
    acknowledgements:
      enabled: true
    buffer:
      type: disk
      max_size: 268435488
      when_full: block
{%- endif %}

  metrics:
    type: prometheus_exporter
    inputs: [internal]
    address: 0.0.0.0:9598
