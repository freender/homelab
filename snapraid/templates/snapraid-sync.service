[Unit]
Description=SnapRAID sync
Documentation=man:snapraid(1)
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p /var/lib/homelab-media && flock -n /var/lib/homelab-media/operations.lock /bin/sh -c "exec /usr/bin/snapraid sync && /usr/bin/snapraid scrub -p 10 -o 30" || { rc=$?; if [ "$rc" -eq 1 ]; then echo "skipped: shared media operations lock is held"; exit 0; fi; exit "$rc"; }'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
