[Unit]
Description=SnapRAID sync
Documentation=man:snapraid(1)
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p /var/lib/homelab-media || exit 1; exec 9>/var/lib/homelab-media/operations.lock || exit 1; if ! flock -n 9; then echo "skipped: shared media operations lock is held"; exit 0; fi; /usr/bin/snapraid sync && /usr/bin/snapraid scrub -p 10 -o 30'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
