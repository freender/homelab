[Unit]
Description=Homelab media mover watch (continuous cache management loop)
{{ SERVICE_DEPENDENCY_LINES }}

[Service]
Type=simple
EnvironmentFile=/etc/default/homelab-media-mover
Environment=PYTHONUNBUFFERED=1
StateDirectory=homelab-media-mover
ExecStart=/usr/local/bin/homelab-media-mover --loop
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
