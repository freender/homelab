# Host-local runtime .env for the zigbee2mqtt stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/zigbee2mqtt/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). Zigbee2MQTT applies ZIGBEE2MQTT_CONFIG_* keys
# over data/configuration.yaml at startup without writing them back.

# Must equal MQTT_Z2M_PASSWORD in /mnt/cache/appdata/mosquitto/.env
ZIGBEE2MQTT_CONFIG_MQTT_PASSWORD="<MQTT_ZIGBEE2MQTT_PASSWORD>"

# Token the Zigbee2MQTT web frontend asks for
ZIGBEE2MQTT_CONFIG_FRONTEND_AUTH_TOKEN="<Z2M_FRONTEND_TOKEN>"
