# Host-local runtime .env for the filebot stack (tower only).
# Never committed with real values -- copy to /mnt/cache/appdata/filebot/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). Consumed by filebot's own post-processing
# scripts (e.g. radarr-rescan.sh), not by compose.yml itself.

JELLYFIN_API_KEY="<JELLYFIN_API_KEY>"
PLEX_TOKEN="<PLEX_TOKEN>"
RADARR_API_KEY="<RADARR_API_KEY>"
SABNZBD_API_KEY="<SABNZBD_API_KEY>"
TELEGRAM_TOKEN="<TELEGRAM_BOT_TOKEN>"
TELEGRAM_CHATID="<TELEGRAM_CHAT_ID>"
