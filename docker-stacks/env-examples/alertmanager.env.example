# Host-local runtime .env for the alertmanager stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/alertmanager/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

# Ping URL the container's entrypoint script hits as a liveness/deadman check
HEALTHCHECK_URL="<HEALTHCHECKS_PING_URL>"

# Default Telegram receiver used by alertmanager.yml.tpl
TELEGRAM_TOKEN="<TELEGRAM_BOT_TOKEN>"
TELEGRAM_CHATID="<TELEGRAM_CHAT_ID>"

# Separate Telegram receiver for Plex-specific alert routes
TELEGRAM_TOKEN_PLEX="<TELEGRAM_BOT_TOKEN_PLEX_ALERTS>"
TELEGRAM_CHATID_PLEX="<TELEGRAM_CHAT_ID_PLEX_ALERTS>"
