# Host-local runtime .env for the qbittorrent stack (tower only).
# Never committed with real values -- copy to /mnt/cache/appdata/qbittorrent/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

VPN_USER="<PROTONVPN_WIREGUARD_USER>"
VPN_PASS="<PROTONVPN_WIREGUARD_PASS>"
