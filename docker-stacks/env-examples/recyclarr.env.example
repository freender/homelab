# Host-local runtime .env for the recyclarr stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/recyclarr/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). recyclarr.yml reads these via !env_var.
# Leave values unquoted: recyclarr-sync preview passes this file to
# `docker run --env-file`, which keeps quotes as part of the value.

RADARR_API_KEY=<RADARR_API_KEY>
RADARR4K_API_KEY=<RADARR4K_API_KEY>
SONARR_API_KEY=<SONARR_API_KEY>
SONARR4K_API_KEY=<SONARR4K_API_KEY>
