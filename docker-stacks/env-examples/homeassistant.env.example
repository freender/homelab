# Host-local runtime .env for the homeassistant stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/homeassistant/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

DOMAIN="example.net"

# Not read by the homeassistant container itself (not in compose.yml's
# environment block) -- consumed by an automation/integration calling back
# into Home Assistant's own API.
HOMEASSISTANT_URL="https://homeassistant.example.net"
HOMEASSISTANT_TOKEN="<HOME_ASSISTANT_LONG_LIVED_ACCESS_TOKEN>"
