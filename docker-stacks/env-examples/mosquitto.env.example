# Host-local runtime .env for the mosquitto stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/mosquitto/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

# Password for MQTT user `homeassistant` (HA MQTT integration)
MQTT_HA_PASSWORD="<MQTT_HOMEASSISTANT_PASSWORD>"

# Password for MQTT user `zigbee2mqtt`
MQTT_Z2M_PASSWORD="<MQTT_ZIGBEE2MQTT_PASSWORD>"
