# Host-local runtime .env for the traefik stack (tower, helm, and neo).
# Never committed with real values -- copy to /mnt/cache/appdata/traefik/.env
# on each host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). REDIS_PASS must match across all three hosts
# -- it is the requirepass/masterauth of the shared Sentinel-managed traefik-kv
# Redis, which every traefik-kop and Traefik authenticates to.

DOMAIN="example.net"
REDIS_PASS="<TRAEFIK_KOP_REDIS_PASSWORD>"
# Read only by helm, the ACME issuer (Cloudflare DNS-01).
TRAEFIK_DNS_API="<CLOUDFLARE_DNS_API_TOKEN>"

# Not referenced by any tracked compose.yml -- likely consumed by fileConfig.yml
# (not repo-managed; carries the route map, see docker-stacks/README.md).
TRAEFIK_URL="https://traefik.example.net"
