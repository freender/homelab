# Host-local runtime .env for the cloudfirewall stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/cloudfirewall/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

CF_BOT_WAF_TOKEN="<CLOUDFLARE_API_TOKEN>"
CF_BOT_WAF_ZONE="<CLOUDFLARE_ZONE_ID>"
CF_BOT_WAF_RULESET="<CLOUDFLARE_WAF_RULESET_ID>"
CF_BOT_WAF_RULEID="<CLOUDFLARE_WAF_RULE_ID>"
