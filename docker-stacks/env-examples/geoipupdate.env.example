# Host-local runtime .env for the geoipupdate stack (helm and tower).
# Never committed with real values -- copy to /mnt/cache/appdata/geoipupdate/.env
# on each host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). Same MaxMind account is expected on both hosts.

GEOIPUPDATE_ACCOUNT_ID="<MAXMIND_ACCOUNT_ID>"
GEOIPUPDATE_LICENSE_KEY="<MAXMIND_LICENSE_KEY>"
