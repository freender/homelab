# Host-local runtime .env for the grafana stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/grafana/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

GRAFANA_URL="https://grafana.example.net"

# Not read by grafana itself (not in compose.yml's environment block) -- consumed
# by an external script/integration that talks to Grafana's HTTP API.
GRAFANA_API_TOKEN="<GRAFANA_SERVICE_ACCOUNT_TOKEN>"
