# Host-local runtime .env for the cloudflared stack (helm and tower).
# Never committed with real values -- copy to /mnt/cache/appdata/cloudflared/.env
# on each host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). Each host runs its own tunnel from the same
# compose.yml.j2, so the same key can carry a different tunnel per host.

CLOUDFLARE_TUNNEL_ID="<CLOUDFLARE_TUNNEL_UUID>"
