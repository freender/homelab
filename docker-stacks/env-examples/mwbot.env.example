# Host-local runtime .env for the mwbot stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/mwbot/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

# Telegram bot identity
TELEGRAM_TOKEN="<TELEGRAM_BOT_TOKEN>"
TELEGRAM_CHATID="<TELEGRAM_CHAT_ID>"
TELEGRAM_OWNER="<TELEGRAM_OWNER_USER_ID>"
TELEGRAM_AUTH_USERS="<COMMA_SEPARATED_TELEGRAM_USER_IDS>"
TELEGRAM_TOKEN_STAGING="<TELEGRAM_BOT_TOKEN_STAGING>"

# UptimeKuma status page mwbot posts maintenance windows to
UPTIME_HOST="<UPTIME_KUMA_HOST_AND_PORT>"
UPTIME_LOGIN="<UPTIME_KUMA_LOGIN>"
UPTIME_PASSWORD="<UPTIME_KUMA_PASSWORD>"

# Cloudflare bot-management WAF rule mwbot toggles during maintenance
MW_BOT_WAF_TOKEN="<CLOUDFLARE_API_TOKEN>"
MW_BOT_WAF_ZONE="<CLOUDFLARE_ZONE_ID>"
MW_BOT_WAF_RULESET="<CLOUDFLARE_WAF_RULESET_ID>"
MW_BOT_WAF_RULEID="<CLOUDFLARE_WAF_RULE_ID>"
MW_BOT_ASN_DEFAULT="<DEFAULT_ASN_FOR_WAF_DEBUG_LOOKUPS>"
CDN_URL="<CDN_DEBUG_URL>"

# *arr / Jellyseerr integrations
SEERR_BASE_URL="<JELLYSEERR_BASE_URL>"
SEERR_API_KEY="<JELLYSEERR_API_KEY>"
SEERR_PUBLIC_URL="<JELLYSEERR_PUBLIC_URL>"
SONARR_BASE_URL="<SONARR_BASE_URL>"
SONARR_API_KEY="<SONARR_API_KEY>"
SONARR4K_BASE_URL="<SONARR4K_BASE_URL>"
SONARR4K_API_KEY="<SONARR4K_API_KEY>"
RADARR_BASE_URL="<RADARR_BASE_URL>"
RADARR_API_KEY="<RADARR_API_KEY>"
RADARR4K_BASE_URL="<RADARR4K_BASE_URL>"
RADARR4K_API_KEY="<RADARR4K_API_KEY>"

# Access-check / maintenance-mode gating (consumed directly by the app; not
# referenced in compose.yml)
ACCESS_CHECK_API_URL="<ACCESS_CHECK_API_URL>"
ACCESS_CHECK_API_TOKEN="<ACCESS_CHECK_API_TOKEN>"
SEERR_ACCESS_ENV_ONLY="false"
SEERR_ACCESS_TEST_MODE="false"
SEERR_ACCESS_TEST_USER_ID="<SEERR_TEST_USER_ID>"
MAINTENANCE_BACKENDS="<COMMA_SEPARATED_BACKEND_NAMES>"

# Alertmanager integration -- silences/mutes during announced maintenance
ALERTMANAGER_URL="<ALERTMANAGER_BASE_URL>"
ALERTMANAGER_OPEN_MW_DURATION="<DURATION_E_G_2h>"

# GitHub incident issue creation (homelab-ops repo)
GITHUB_INCIDENT_TOKEN="<GITHUB_FINE_GRAINED_PAT>"
