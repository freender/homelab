# Host-local runtime .env for the immich stack (neo only).
# Never committed with real values -- copy to /mnt/cache/appdata/immich/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

DOMAIN="example.net"

# immich-postgresql's own credentials
POSTGRES_USER="<IMMICH_DB_USER>"
POSTGRES_PASSWORD="<IMMICH_DB_PASSWORD>"
POSTGRES_DB="<IMMICH_DB_NAME>"

# immich-server's view of the same database -- DB_* must match POSTGRES_*
# above, or the immich container cannot connect to immich-postgresql.
DB_USERNAME="<IMMICH_DB_USER>"
DB_PASSWORD="<IMMICH_DB_PASSWORD>"
DB_DATABASE_NAME="<IMMICH_DB_NAME>"

IMMICH_REDIS_PASSWORD="<IMMICH_REDIS_PASSWORD>"
