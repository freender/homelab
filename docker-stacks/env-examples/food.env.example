# Host-local runtime .env for the food (mealie) stack (helm only).
# Never committed with real values -- copy to /mnt/cache/appdata/food/.env
# on the host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md).

BASE_URL="https://food.example.net"
DEFAULT_EMAIL="<DEFAULT_ADMIN_EMAIL>"
OPENAI_API_KEY="<OPENAI_API_KEY>"

# SMTP used for mealie's own notification emails
SMTP_HOST="<SMTP_HOST>"
SMTP_USER="<SMTP_USERNAME>"
SMTP_PASSWORD="<SMTP_PASSWORD>"
SMTP_FROM_EMAIL="<SMTP_FROM_EMAIL>"
