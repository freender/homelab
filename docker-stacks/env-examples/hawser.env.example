# Host-local runtime .env for the hawser stack (neo and tower).
# Never committed with real values -- copy to /mnt/cache/appdata/hawser/.env
# on each host and fill in real values. docker-stacks does not manage this file
# (see docker-stacks/README.md). hawser is per-host (compose.yml.j2 renders
# hawser-{{ HOST }}), so AGENT_NAME and TOKEN are expected to differ per host.

AGENT_NAME="<HOST_NAME>"
DOCKER_SOCKET="unix:///var/run/docker.sock"
STACKS_DIR="/data/stacks"
LOG_LEVEL="info"
PORT="<AGENT_LISTEN_PORT>"
TOKEN="<HAWSER_AGENT_AUTH_TOKEN>"
