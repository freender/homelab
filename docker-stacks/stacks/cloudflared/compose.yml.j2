# Shared stack: rendered once per host that declares `cloudflared` in hosts.conf.
# Host-invariant by construction -- if a host ever needs to differ, move it to
# stacks/<host>/cloudflared/compose.yml rather than adding a conditional here.
#
# One tunnel, one replica per host: every host's .env carries the same
# CLOUDFLARE_TUNNEL_ID and credentials, and Cloudflare fails over between the
# connectors. Ingress (host-local config.yml) must target the local traefik-<host>
# over net.internal, not the VIP: allow-cdn@file only admits the docker subnet.
# net.internal is a per-host bridge, so the container name only has to be unique
# on its own host.
networks:
  net.internal:
    external: true

services:
  cloudflared-{{ HOST }}:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared-{{ HOST }}
    init: true
    stop_grace_period: 20s
    restart: always
    mem_limit: 1g
    env_file:
      - .env
    environment:
      TZ: 'America/New_York'
    command: tunnel run ${CLOUDFLARE_TUNNEL_ID}
    volumes:
      - /mnt/cache/appdata/cloudflared:/etc/cloudflared
    networks:
      net.internal: {}
