#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$SCRIPT_DIR/.venv/bin/python" ]]; then
    PYTHONPATH="$SCRIPT_DIR/src" exec "$SCRIPT_DIR/.venv/bin/python" -m homelab.cli validate "$@"
fi

if command -v uv >/dev/null 2>&1; then
    cd "$SCRIPT_DIR"
    PYTHONPATH="$SCRIPT_DIR/src" exec uv run python -m homelab.cli validate "$@"
fi

cd "$SCRIPT_DIR"
PYTHONPATH="$SCRIPT_DIR/src" exec python3 -m homelab.cli validate "$@"
