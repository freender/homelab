# Secrets
**/.env
**/telegram.env
**/*.env

# Allow examples and op-inject templates (no secret values)
!**/.env.example
!secrets/templates/*.env.tpl
!secrets/templates/*.env.tpl.example
!secrets/catalog.yml

# Local overrides
*.local
*.backup

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
.claude/

# Logs
*.log

# Downloaded binaries
.bin/

# Build artifacts
**/build/

# Python artifacts
.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
