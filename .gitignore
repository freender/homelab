# Secrets
**/.env
**/telegram.env
**/*.env

# Allow examples and op-inject templates (no secret values)
!**/.env.example
!secrets/templates/*.env.tpl
!secrets/templates/*.env.tpl.example
!secrets/catalog.yml

# Local overrides
*.local
*.backup

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code: ignore local settings, but track the project skills dir
# (.claude/skills/* symlinks into .opencode/skill/ so both CLIs see one copy)
.claude/*
!.claude/skills/

# Logs
*.log

# Downloaded binaries
.bin/

# Build artifacts
**/build/

# Python artifacts
.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
.coverage
.pytest_cache/
