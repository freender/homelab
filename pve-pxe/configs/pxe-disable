#!/usr/bin/env bash
# pxe-disable - Stop dnsmasq PXE service.
# nginx is kept running to serve baked ISOs via /iso/ at all times.
# Safe to run multiple times; idempotent.
set -euo pipefail

systemctl stop dnsmasq 2>/dev/null || true

echo "pxe-disable: dnsmasq stopped (nginx kept running for ISO downloads)"
