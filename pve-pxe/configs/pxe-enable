#!/usr/bin/env bash
# pxe-enable - Start nginx HTTP Boot service.
# Safe to run multiple times; idempotent.
set -euo pipefail

HTTPBOOT_IPXE=/srv/pxe/httpboot/ipxe.efi
HTTPBOOT_AUTOEXEC=/srv/pxe/httpboot/autoexec.ipxe

if [[ ! -f "$HTTPBOOT_IPXE" || ! -f "$HTTPBOOT_AUTOEXEC" ]]; then
    echo "pxe-enable: missing HTTP Boot files under /srv/pxe/httpboot" >&2
    exit 1
fi

systemctl start nginx

echo "pxe-enable: nginx started for HTTP Boot"
