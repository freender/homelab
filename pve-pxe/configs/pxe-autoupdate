#!/usr/bin/env bash
# pxe-autoupdate - Detect, build, validate, and atomically promote a new Proxmox VE PXE payload.
# Reads the PDM answer-auth token from TOKEN_FILE; never prints it.
# Writes a node_exporter textfile metric on each run.
set -euo pipefail

ISO_INDEX="https://enterprise.proxmox.com/iso/"
ISO_DIR="/root/iso"
SRV="/srv/pxe"
STAGE="/srv/pxe.stage"
TOKEN_FILE="/root/homelab-pve-auto-install.token"
METRIC="/var/lib/node_exporter/textfile/pxe_autoupdate.prom"
LOCK="/run/pxe-autoupdate.lock"

# PDM connection details (written by homelab deploy; do not edit here)
# shellcheck source=/etc/saint/pxe-mgmt.conf
source /etc/saint/pxe-mgmt.conf

log()    { echo "pxe-autoupdate: $*"; }
metric() {
    mkdir -p "$(dirname "$METRIC")"
    printf 'pve_pxe_autoupdate_result %s\npve_pxe_autoupdate_timestamp %s\n' \
        "$1" "$(date +%s)" > "$METRIC.tmp" && mv "$METRIC.tmp" "$METRIC"
}
fail()   { log "ERROR: $*" >&2; metric 1; exit 1; }

# Prevent overlapping runs
exec 9>"$LOCK"
flock -n 9 || { log "another run is active"; exit 0; }

# 1. Detect latest upstream ISO
latest="$(curl -fsSL "$ISO_INDEX" | grep -oE "proxmox-ve_[0-9]+\.[0-9]+-[0-9]+\.iso" | sort -V | tail -1)"
[[ -n "$latest" ]] || fail "could not determine latest upstream ISO"

staged="$(find "$SRV" -maxdepth 1 -name 'proxmox-ve_*.iso' -printf '%f\n' 2>/dev/null | sort -V | tail -1)"
if [[ "$latest" == "$staged" ]]; then
    log "up to date ($staged)"
    metric 0
    exit 0
fi
log "new ISO $latest (staged: ${staged:-none}); rebuilding payload"

# 2. Download + verify new ISO
mkdir -p "$ISO_DIR"
cd "$ISO_DIR"
curl -fLO "${ISO_INDEX}${latest}"
if curl -fsSL "${ISO_INDEX}${latest}.sha256sum" -o "${latest}.sha256sum" 2>/dev/null; then
    grep -E "  ?${latest}\$" "${latest}.sha256sum" | sha256sum -c - \
        || log "WARN: sha256sum mismatch — proceeding with caution"
else
    log "WARN: no upstream sha256sum available"
fi

# 3. Build prepared PXE payload
command -v proxmox-auto-install-assistant >/dev/null \
    || apt-get install -y proxmox-auto-install-assistant xorriso >/dev/null
[[ -s "$TOKEN_FILE" ]] || fail "missing or empty token file $TOKEN_FILE"

PXE_BUILD="$ISO_DIR/pxe-build"
rm -rf "$PXE_BUILD"
mkdir -p "$PXE_BUILD"
proxmox-auto-install-assistant prepare-iso "$ISO_DIR/$latest" \
    --pxe --pxe-loader ipxe --fetch-from http \
    --url "$PDM_URL" \
    --cert-fingerprint "$PDM_CERT_FINGERPRINT" \
    --answer-auth-token "$(cat "$TOKEN_FILE")" \
    --output "$PXE_BUILD" >/dev/null

[[ -s "$PXE_BUILD/vmlinuz" && -s "$PXE_BUILD/initrd.img" ]] \
    || fail "prepare-iso did not produce vmlinuz/initrd.img"

# 4. Assemble staging copy with new payload + version-bumped loaders
ver="${latest%.iso}"
ver="${ver#proxmox-ve_}"
rm -rf "$STAGE"
cp -a "$SRV" "$STAGE"
rm -f "$STAGE"/proxmox-ve_*.iso
install -m 0644 "$PXE_BUILD/vmlinuz"    "$STAGE/vmlinuz"
install -m 0644 "$PXE_BUILD/initrd.img" "$STAGE/initrd.img"
install -m 0644 "$ISO_DIR/$latest"      "$STAGE/$latest"
sed -i -E "s/proxmox-ve_[0-9.]+-[0-9]+/proxmox-ve_${ver}/g" \
    "$STAGE/pve-load.ipxe" "$STAGE/pdm-auto.ipxe"

# 5. Validate staged payload consistency
grep -q "proxmox-ve_${ver}" "$STAGE/pve-load.ipxe" \
    || fail "pve-load.ipxe not pointing at proxmox-ve_${ver}"
for f in vmlinuz initrd.img "$latest" boot.ipxe pve-load.ipxe pdm-auto.ipxe; do
    [[ -s "$STAGE/$f" ]] || fail "staged payload missing $f"
done

# 6. Atomically promote: keep rollback copy, swap dirs, reload nginx
need_disable=0
systemctl is-active --quiet nginx || { /usr/local/sbin/pxe-enable; need_disable=1; }
rm -rf "$SRV.prev"
cp -a "$SRV" "$SRV.prev"
rsync -a --delete "$STAGE"/ "$SRV"/
systemctl reload nginx 2>/dev/null || systemctl restart nginx

# 7. Post-promote HTTP smoke test
ok=1
curl -fsI "http://127.0.0.1/$latest"    >/dev/null || ok=0
curl -fsI "http://127.0.0.1/initrd.img" >/dev/null || ok=0
curl -fsI "http://127.0.0.1/boot.ipxe"  >/dev/null || ok=0
if [[ "$ok" -ne 1 ]]; then
    log "post-promote check failed; rolling back"
    rsync -a --delete "$SRV.prev"/ "$SRV"/
    systemctl reload nginx 2>/dev/null || systemctl restart nginx
    [[ "$need_disable" -eq 1 ]] && /usr/local/sbin/pxe-disable || true
    fail "rolled back to previous payload"
fi

# 8. Rebuild baked offsite ISOs from the newly promoted base ISO.
if command -v iso-autobuild >/dev/null 2>&1; then
    iso-autobuild || fail "baked ISO rebuild failed"
else
    log "WARN: iso-autobuild not installed; baked ISO rebuild skipped"
fi

# 9. Clean up: keep current + one previous ISO in /root/iso
ls -1t "$ISO_DIR"/proxmox-ve_*.iso 2>/dev/null | tail -n +3 | xargs -r rm -f
[[ "$need_disable" -eq 1 ]] && /usr/local/sbin/pxe-disable || true

log "promoted proxmox-ve_${ver}"
metric 0
