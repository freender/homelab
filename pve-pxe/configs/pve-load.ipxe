#!ipxe
# pve-load.ipxe - Shared initrd/ISO loader for Proxmox VE PXE installs.
# The proxmox-ve_* ISO filename is updated by pxe-autoupdate on each version bump.

:load
initrd --name initrd.img http://10.0.0.51/initrd.img
initrd http://10.0.0.51/proxmox-ve_9.2-1-auto-from-http-url-fp.iso proxmox.iso
boot
