#!ipxe
# pve-load.ipxe - Shared initrd/ISO loader for Proxmox VE PXE installs.
# The proxmox-ve_* ISO filename is updated by pxe-autoupdate on each version bump.

:load
isset ${pve-kargs} || set pve-kargs ro ramdisk_size=16777216 rw quiet splash=silent
kernel http://10.0.0.50/vmlinuz initrd=initrd.img ${pve-kargs}
initrd --name initrd.img http://10.0.0.50/initrd.img
initrd http://10.0.0.50/proxmox-ve_PLACEHOLDER.iso proxmox.iso
boot
