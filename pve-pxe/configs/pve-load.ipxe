#!ipxe
# pve-load.ipxe - Shared initrd/ISO loader for Proxmox VE network installs.
# The proxmox-ve_* ISO filename is updated by pxe-autoupdate on each version bump.

:load
isset ${pve-kargs} || set pve-kargs ro ramdisk_size=16777216 rw quiet splash=silent
kernel http://${pxe-server}/vmlinuz initrd=initrd.img ${pve-kargs}
initrd --name initrd.img http://${pxe-server}/initrd.img
initrd http://${pxe-server}/proxmox-ve_PLACEHOLDER.iso proxmox.iso
boot
