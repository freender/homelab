[Unit]
Description=Homelab Docker container startup
After=docker.service{% if DOCKER_DEPENDENCY_UNITS %} {{ DOCKER_DEPENDENCY_UNITS }}{% endif %}
Requires=docker.service{% if DOCKER_DEPENDENCY_UNITS %} {{ DOCKER_DEPENDENCY_UNITS }}{% endif %}
OnFailure=homelab-notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=/mnt/cache/appdata/start.sh --no-pull
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
