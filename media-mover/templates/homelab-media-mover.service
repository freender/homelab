[Unit]
Description=Homelab media mover
{{ SERVICE_DEPENDENCY_LINES }}

[Service]
Type=oneshot
EnvironmentFile=/etc/default/homelab-media-mover
EnvironmentFile=-/etc/default/homelab-media-mover.local
Environment=PYTHONUNBUFFERED=1
StateDirectory=homelab-media-mover
ExecStart=/usr/local/bin/homelab-media-mover
StandardOutput=journal
StandardError=journal
