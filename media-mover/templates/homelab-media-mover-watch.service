[Unit]
Description=Homelab media mover watch (continuous sync and cache drain)
{{ SERVICE_DEPENDENCY_LINES }}

[Service]
Type=simple
EnvironmentFile=/etc/default/homelab-media-mover
EnvironmentFile=-/etc/default/homelab-media-mover.local
Environment=PYTHONUNBUFFERED=1
StateDirectory=homelab-media-mover
ExecStart=/usr/local/bin/homelab-media-mover --loop --sync-only --demote-non-frequent
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
