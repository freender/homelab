#!/usr/bin/python3
"""Textfile metrics for solar: solar-check results and Bazzite update state.

Run by solar-metrics.timer as the desktop user (vr-guest, freender/homelab-ops#400).
node_exporter's textfile collector publishes the result; the rules are
vmalert-rules/configs/solar.yml.
"""
import json
import os
import re
import subprocess
import tempfile
from pathlib import Path

TEXTFILE = Path("/var/lib/node_exporter/textfile/solar.prom")
CHECK = Path("/usr/local/libexec/solar-check")
CHECK_LINE = re.compile(r"^\s+(ok|FAIL)\s+(\S+?)(?::\s.*)?$")
UUPD_DONE = "Updates Completed Successfully"
# Packages whose change in a staged image decides how much a reboot costs: a new
# terra-bluez means rebuilding the patched bluetoothd, kernel and kmod-nvidia are
# what break passthrough or the headset if anything does.
# Exact names, not prefixes: kernel-headers or kernel-srpm-macros bump without the
# booted kernel changing. Bazzite ships terra-bluez; plain bluez is kept in case
# it switches back.
WATCHED_PACKAGES = {
    "bluez": {"terra-bluez", "bluez"},
    "kernel": {"kernel", "kernel-core"},
    "kmod-nvidia": {"kmod-nvidia"},
}


def escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def run(*cmd: str) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=300, check=False)


def check_metrics() -> list[str]:
    lines = [
        "# HELP homelab_solar_check 1 when a solar-check item passes, 0 when it fails.",
        "# TYPE homelab_solar_check gauge",
    ]
    results = []
    if CHECK.is_file():
        proc = run(str(CHECK))
        results = [m.groups() for m in map(CHECK_LINE.match, proc.stdout.splitlines()) if m]
        ran = proc.returncode in (0, 1) and bool(results)
    else:
        ran = False
    for status, check in results:
        lines.append(f'homelab_solar_check{{check="{escape(check)}"}} {int(status == "ok")}')
    lines += [
        "# HELP homelab_solar_check_run_success 1 when solar-check ran and reported results.",
        "# TYPE homelab_solar_check_run_success gauge",
        f"homelab_solar_check_run_success {int(ran)}",
    ]
    return lines


def ostree_metrics() -> list[str]:
    proc = run("rpm-ostree", "status", "--json")
    if proc.returncode != 0:
        return []
    deployments = json.loads(proc.stdout).get("deployments") or []
    booted = next((d for d in deployments if d.get("booted")), None)
    if booted is None:
        return []
    # A staged or finalized-but-unbooted deployment sorts ahead of the booted one.
    pending = deployments[0] if not deployments[0].get("booted") else None
    image = booted.get("container-image-reference", "")
    lines = [
        "# HELP homelab_ostree_booted_info The booted rpm-ostree deployment.",
        "# TYPE homelab_ostree_booted_info gauge",
        f'homelab_ostree_booted_info{{version="{escape(booted.get("version", ""))}",'
        f'image="{escape(image)}"}} 1',
        "# HELP homelab_ostree_booted_timestamp_seconds Build time of the booted image.",
        "# TYPE homelab_ostree_booted_timestamp_seconds gauge",
        f"homelab_ostree_booted_timestamp_seconds {int(booted.get('timestamp', 0))}",
        "# HELP homelab_ostree_update_pending 1 when a newer deployment waits for a reboot.",
        "# TYPE homelab_ostree_update_pending gauge",
        f"homelab_ostree_update_pending {int(pending is not None)}",
    ]
    if pending is not None:
        lines += [
            "# HELP homelab_ostree_pending_info The deployment the next boot will use.",
            "# TYPE homelab_ostree_pending_info gauge",
            f'homelab_ostree_pending_info{{version="{escape(pending.get("version", ""))}"}} 1',
        ]
        lines += pending_change_metrics()
    return lines


def changed_packages(diff: str) -> set[str]:
    """Names in `rpm-ostree db diff` block output (its --format=json prints block too).

    Upgraded/Downgraded entries read `  name old -> new`; Added/Removed entries are a
    bare `  name-version-release.arch`.
    """
    names = set()
    for line in diff.splitlines():
        if not line.startswith("  ") or not line.strip():
            continue
        entry = line.split()[0]
        names.add(entry if " " in line.strip() else entry.rsplit("-", 2)[0])
    return names


def pending_change_metrics() -> list[str]:
    proc = run("rpm-ostree", "db", "diff")
    if proc.returncode != 0:
        return []
    names = changed_packages(proc.stdout)
    lines = [
        "# HELP homelab_ostree_pending_package_changed 1 when the staged image changes "
        "this package family.",
        "# TYPE homelab_ostree_pending_package_changed gauge",
    ]
    for family, packages in WATCHED_PACKAGES.items():
        lines.append(
            f'homelab_ostree_pending_package_changed{{package="{family}"}} {int(bool(names & packages))}'
        )
    return lines


def uupd_metrics() -> list[str]:
    # The journal, not the unit's ExecMainExitTimestamp: that resets on every boot.
    proc = run(
        "journalctl", "-q", "-u", "uupd.service", "--since=-30d",
        "-o", "short-unix", f"--grep={UUPD_DONE}",
    )
    stamps = [line.split(None, 1)[0] for line in proc.stdout.splitlines() if UUPD_DONE in line]
    last = int(float(stamps[-1])) if stamps else 0
    return [
        "# HELP homelab_uupd_last_success_timestamp_seconds Last uupd run that completed "
        "successfully (0: none in 30 days).",
        "# TYPE homelab_uupd_last_success_timestamp_seconds gauge",
        f"homelab_uupd_last_success_timestamp_seconds {last}",
    ]


def main() -> None:
    body = "\n".join(check_metrics() + ostree_metrics() + uupd_metrics()) + "\n"
    fd, tmp = tempfile.mkstemp(dir=TEXTFILE.parent, prefix=".solar.prom.")
    with os.fdopen(fd, "w") as handle:
        handle.write(body)
    os.chmod(tmp, 0o644)
    os.replace(tmp, TEXTFILE)


if __name__ == "__main__":
    main()
