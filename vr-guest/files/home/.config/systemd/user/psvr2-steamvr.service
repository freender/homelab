[Unit]
Description=SteamVR session while the PS VR2 headset is powered on
# 71-psvr2-steamvr.rules aliases the headset's sound card as /dev/psvr2; the
# headset powering off removes it, which stops this unit and quits SteamVR.
BindsTo=dev-psvr2.device
After=dev-psvr2.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/psvr2-steamvr start
ExecStart=%h/.local/bin/psvr2-audio
ExecStop=%h/.local/bin/psvr2-steamvr stop
TimeoutStartSec=3min
# Grace, quit with SIGTERM/SIGKILL fallbacks, then a Steam restart: ~2 min worst case.
TimeoutStopSec=4min
