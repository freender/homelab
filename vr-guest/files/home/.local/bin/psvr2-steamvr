#!/usr/bin/env bash
# Start SteamVR when the PS VR2 headset powers on, quit it when the headset powers
# off (solar, freender/homelab-ops#389). psvr2-steamvr.service runs `start` when
# 71-psvr2-steamvr.rules pulls it in, and `stop` when the headset's device unit
# goes away. `quit` quits SteamVR without the headset check, for testing.
#
# Before launching SteamVR it restarts a Steam whose webhelper was respawned or
# that is not logged in: either leaves the launch waiting on a prompt nobody sees.
#
# Quitting asks vrmonitor first, then SIGTERM, then SIGKILL, and fails if SteamVR
# survives all three. After a headset-off quit it restarts Steam if the quit
# crashed its webhelper. During system shutdown it quits at once, with no grace.
# A headset back within the grace has its start refused by systemd, so `stop`
# starts the unit again itself. `start` relaunches a SteamVR left without its
# compositor rather than adopting it.
set -euo pipefail

STEAMVR_APPID=250820
COOLDOWN=60
SETTLE=3
# A headset power-cycle re-enumerates USB within a few seconds; only quit once
# the headset has stayed gone this long.
GRACE=10
QUIT_TIMEOUT=30
TERM_TIMEOUT=10
KILL_TIMEOUT=5
STEAM_EXIT_TIMEOUT=30
# Steam starts its webhelper within seconds of the client. A webhelper this much
# younger than its client was respawned after a crash, and a respawned webhelper
# never shows the launch prompt, so the SteamVR launch hangs on it.
WEBHELPER_RESPAWN_AGE=60
# Quitting SteamVR aborts steamwebhelper about 2s later (ValveSoftware/SteamVR-for-Linux#964).
WEBHELPER_CRASH_WAIT=5
CONNECTION_LOG="$HOME/.local/share/Steam/logs/connection_log.txt"
UNIT=psvr2-steamvr.service
# Long enough for the stop job that queues it to have finished.
REQUEUE_DELAY=3
# vrserver starts a few seconds before vrcompositor; only a vrserver older than
# this without one is a SteamVR whose compositor died.
COMPOSITOR_START_AGE=30
# The headset's sound card, the same device the service is bound to.
HEADSET_UNIT=dev-psvr2.device
STEAMVR_PROCS=(vrmonitor vrdashboard vrwebhelper vrcompositor vrserver)

state="${XDG_RUNTIME_DIR:-/tmp}/psvr2-steamvr"

steamvr_running() {
    pgrep -u "$UID" -x vrserver >/dev/null || pgrep -u "$UID" -x vrcompositor >/dev/null \
        || pgrep -u "$UID" -x vrmonitor >/dev/null
}

headset_present() {
    systemctl --user is-active --quiet "$HEADSET_UNIT"
}

shutting_down() {
    [[ "$(systemctl is-system-running 2>/dev/null || true)" == stopping ]]
}

# Takes the lock for the rest of the run; children that may outlive it close fd 9.
lock() {
    exec 9>"$state.lock"
    flock "$@" 9
}

launcher() {
    # bazzite-steam adds Bazzite's NVIDIA and Wayland (extest) setup that plain
    # `steam` skips.
    if command -v bazzite-steam >/dev/null; then echo bazzite-steam; else echo steam; fi
}

# With every desktop output DPMS-off, Steam creates its windows hidden and
# waits forever on the hidden login window or launch prompt.
wake_screen() {
    kscreen-doctor --dpms on >/dev/null 2>&1 || echo "could not wake the desktop screen"
}

# Its own transient unit: a `steam` that becomes the Steam client must outlive
# this oneshot's cgroup. -pipewire matches the autostart entry: on Wayland, Remote
# Play (Steam Link) can capture the desktop only through PipeWire.
launch_steam() {
    systemd-run --user --collect --no-block --quiet "$(launcher)" -pipewire "$@" 9>&-
}

# Prints "<client pid> <client age> <webhelper age>" for the running Steam client.
steam_ages() {
    local ppid helper_age client_age
    read -r ppid helper_age < <(ps -u "$UID" -o ppid=,etimes=,args= \
        | awk '$3 ~ /(^|\/)steamwebhelper$/ && !/--type=/ { print $1, $2 }' | sort -k2 -n -r | head -n1) || return 1
    client_age=$(ps -o etimes= -p "$ppid") || return 1
    echo "$ppid ${client_age// /} $helper_age"
}

# Sets steam_client to the Steam client's pid when its webhelper was respawned.
webhelper_respawned() {
    local client_age helper_age
    read -r steam_client client_age helper_age < <(steam_ages) || return 1
    (( client_age - helper_age > WEBHELPER_RESPAWN_AGE )) || return 1
    echo "steamwebhelper is ${helper_age}s old but Steam ${client_age}s: respawned, restarting Steam"
}

# Sets steam_client when the running Steam is not logged in. A Steam started with
# no usable screen sits at a login window it never shows, and its connection log
# ends on a Logged Off state with no account ([U:1:0]); a restart logs it in.
steam_logged_off() {
    local last
    read -r steam_client _ _ < <(steam_ages) || return 1
    last=$(grep -E '^\[[^]]+\] \[[^]]+\] \[U:' "$CONNECTION_LOG" 2>/dev/null | tail -n1) || return 1
    [[ "$last" == *"] [Logged Off, "*"] [U:1:0] "* ]] || return 1
    echo "Steam is not logged in, restarting it"
}

shutdown_steam() {
    local i
    timeout 10 steam -shutdown >/dev/null 2>&1 9>&- || true
    for (( i = 0; i < STEAM_EXIT_TIMEOUT; i++ )); do
        kill -0 "$steam_client" 2>/dev/null || return 0
        sleep 1
    done
    # A client blocked on the hidden launch prompt ignores -shutdown too.
    echo "Steam ignored -shutdown for ${STEAM_EXIT_TIMEOUT}s, terminating it"
    kill -TERM "$steam_client" 2>/dev/null || true
    for (( i = 0; i < 15; i++ )); do
        kill -0 "$steam_client" 2>/dev/null || break
        sleep 1
    done
    pkill -u "$UID" -KILL -x steamwebhelper || true
    pkill -u "$UID" -KILL -x steam || true
    sleep 2
}

wait_steamvr_exit() {
    local i
    for (( i = 0; i < $1; i++ )); do
        steamvr_running || return 0
        sleep 1
    done
    ! steamvr_running
}

signal_steamvr() {
    local proc
    for proc in "${STEAMVR_PROCS[@]}"; do
        pkill -u "$UID" "-$1" -x "$proc" || true
    done
}

# A headset-off with nothing quitting SteamVR (the unit already stopped) leaves
# vrserver and vrmonitor running after vrcompositor aborts on the lost display;
# adopting that session leaves the headset blank.
compositor_dead() {
    local age
    pgrep -u "$UID" -x vrcompositor >/dev/null && return 1
    age=$(ps -u "$UID" -o etimes=,comm= | awk '$2 == "vrserver" { print $1; exit }')
    [[ -n "$age" ]] && (( age > COMPOSITOR_START_AGE ))
}

start() {
    lock -n || exit 0

    if compositor_dead; then
        echo "SteamVR running without its compositor, restarting it"
        quit
    elif steamvr_running; then
        echo "SteamVR already running"
        exit 0
    fi

    now=$(date +%s)
    last=$(cat "$state.last" 2>/dev/null || echo 0)
    if (( now - last < COOLDOWN )); then
        echo "SteamVR launched $(( now - last ))s ago, skipping"
        exit 0
    fi
    echo "$now" >"$state.last"

    wake_screen
    if webhelper_respawned || steam_logged_off; then
        shutdown_steam
    fi
    sleep "$SETTLE"
    echo "starting SteamVR"
    launch_steam "steam://rungameid/$STEAMVR_APPID"
}

# Returns non-zero only if SteamVR survives SIGKILL.
quit() {
    if ! steamvr_running; then
        echo "SteamVR not running"
        return 0
    fi
    echo "quitting SteamVR"
    # A deliberate quit: the next headset-on must not be held off by the cooldown.
    rm -f "$state.last"
    if pgrep -u "$UID" -x vrmonitor >/dev/null; then
        # Same request SteamVR's own Quit makes; vrmonitor.sh sets up the SteamVR env.
        timeout 10 "$HOME/.local/share/Steam/steamapps/common/SteamVR/bin/vrmonitor.sh" vrmonitor://quit \
            >/dev/null 2>&1 9>&- || true
        if wait_steamvr_exit "$QUIT_TIMEOUT"; then
            echo "SteamVR quit"
            return 0
        fi
        echo "SteamVR still running after ${QUIT_TIMEOUT}s, sending SIGTERM"
    else
        echo "vrmonitor not running, so nothing to ask to quit; sending SIGTERM"
    fi
    signal_steamvr TERM
    if wait_steamvr_exit "$TERM_TIMEOUT"; then
        echo "SteamVR exited on SIGTERM"
        return 0
    fi
    echo "SteamVR still running ${TERM_TIMEOUT}s after SIGTERM, sending SIGKILL"
    signal_steamvr KILL
    if wait_steamvr_exit "$KILL_TIMEOUT"; then
        echo "SteamVR killed"
        return 0
    fi
    echo "SteamVR still running after SIGKILL: $(pgrep -u "$UID" -l -x "$(IFS='|'; echo "${STEAMVR_PROCS[*]}")" | tr '\n' ' ')" >&2
    return 1
}

# A respawned webhelper leaves the Steam library missing from the next session's
# dashboard; restart Steam now rather than at the next headset-on.
restart_crashed_steam() {
    sleep "$WEBHELPER_CRASH_WAIT"
    headset_present && return 0
    if webhelper_respawned; then
        shutdown_steam
        wake_screen
        launch_steam
    fi
}

# The re-plug's start arrives while this stop job runs, and systemd refuses it
# ("transaction is destructive"): the unit would end stopped with the headset on,
# and the next headset-off would quit nothing. Start it once this stop is done.
requeue_start() {
    echo "starting $UNIT again in ${REQUEUE_DELAY}s"
    # A user timer's default AccuracySec=1min stretches the delay to ~12s.
    systemd-run --user --collect --no-block --quiet --on-active="$REQUEUE_DELAY" \
        --timer-property=AccuracySec=100ms systemctl --user start "$UNIT" 9>&-
}

# Waits up to GRACE seconds; succeeds as soon as the headset is back.
headset_returns() {
    local i
    for (( i = 0; i < GRACE; i++ )); do
        headset_present && return 0
        sleep 1
    done
    headset_present
}

stop() {
    lock -w 60
    if shutting_down; then
        echo "system shutting down, quitting SteamVR without the ${GRACE}s grace"
        quit
        return
    fi
    if headset_returns; then
        if ! steamvr_running; then
            echo "headset back within ${GRACE}s and SteamVR not running, leaving it to start"
        # vrwebhelper draws the SteamVR dashboard and overlay and is not respawned
        # after a crash; quitting lets the requeued start relaunch it.
        elif pgrep -u "$UID" -x vrwebhelper >/dev/null; then
            echo "headset back within ${GRACE}s, leaving SteamVR running"
        else
            echo "headset back within ${GRACE}s but the SteamVR overlay has crashed, restarting SteamVR"
            quit
        fi
        requeue_start
        return
    fi
    if ! steamvr_running; then
        echo "SteamVR not running"
        return 0
    fi
    quit
    restart_crashed_steam
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    quit) lock -w 180; quit ;;
    *) echo "usage: $0 [start|stop|quit]" >&2; exit 2 ;;
esac
