[Unit]
Description=Vector: ships the journal and Steam's logs to VictoriaLogs on helm (vr-guest, homelab-ops#402)
Documentation=https://vector.dev
After=network-online.target
Wants=network-online.target
# Retry every 30 s forever: VictoriaLogs being down at boot (a helm reboot) must
# not leave it failed for good (homelab-ops#373). The disk buffer and the
# journald checkpoint hold the backlog.
StartLimitIntervalSec=0

[Service]
# No vector user: the pinned tarball ships none, and systemd-journal is all it
# needs. /var/lib/vector is the config's data_dir.
DynamicUser=yes
SupplementaryGroups=systemd-journal
# Steam's logs sit under the desktop user's 0700 home. Read-only bypass, so no
# ACLs to keep alive as Steam renames and recreates them; DynamicUser already
# makes the home read-only to this unit.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
StateDirectory=vector
Environment=VECTOR_CONFIG=/etc/vector/homelab.yaml
# A journal and a few log files need no more; the default is one worker per CPU.
Environment=VECTOR_THREADS=2
# Down from 60 s, so a batch that cannot reach helm does not hold a reboot; it
# is resent from the disk buffer at the next start.
Environment=VECTOR_GRACEFUL_SHUTDOWN_LIMIT_SECS=5
ExecStartPre=/usr/local/bin/vector validate --skip-healthchecks
ExecStart=/usr/local/bin/vector
ExecReload=/usr/local/bin/vector validate --skip-healthchecks
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=30s

[Install]
WantedBy=multi-user.target
