#!/bin/bash

set -euo pipefail

HOST="${HOSTNAME_OVERRIDE:-$(hostname -s)}"
OUT_DIR="/var/lib/prometheus/node-exporter"
OUT_FILE="$OUT_DIR/zfs-pools.prom"
# Optional per-host list of pools that are expected to be imported. `zpool list`
# only reports pools that actually imported, so a pool that fails to import (or
# is degraded past the point of importing at boot) silently drops its whole
# series instead of going unhealthy -- an absent series never matches
# `homelab_zpool_healthy == 0`. Naming the expected pools lets this exporter
# report them as healthy=0/state=MISSING instead of emitting nothing at all.
# When the file is absent the exporter only reports what is imported, exactly as
# before, so hosts that opt out are unaffected.
EXPECTED_POOLS_FILE="${ZFS_EXPECTED_POOLS_FILE:-/etc/homelab/zfs-expected-pools.conf}"

mkdir -p "$OUT_DIR"
TMP_FILE="$(mktemp "$OUT_DIR/.zfs-pools.prom.XXXXXX")"

cleanup() {
    rm -f "$TMP_FILE"
}
trap cleanup EXIT

pool_tier() {
    case "$1" in
        vault-hdd) printf 'hdd' ;;
        *) printf 'ssd' ;;
    esac
}

pool_role() {
    case "$1" in
        vault-hdd) printf 'media' ;;
        vm-flash) printf 'vm' ;;
        rpool) printf 'boot' ;;
        cache) printf 'cache' ;;
        *) printf 'general' ;;
    esac
}

write_metric() {
    local metric="$1"
    local pool="$2"
    local value="$3"
    local tier role
    tier="$(pool_tier "$pool")"
    role="$(pool_role "$pool")"
    printf '%s{host="%s",zpool="%s",tier="%s",role="%s"} %s\n' \
        "$metric" "$HOST" "$pool" "$tier" "$role" "$value"
}

read_expected_pools() {
    [[ -r "$EXPECTED_POOLS_FILE" ]] || return 0
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | tr -d '[:space:]')"
        [[ -n "$line" ]] || continue
        printf '%s\n' "$line"
    done < "$EXPECTED_POOLS_FILE"
}

write_labeled_metric() {
    local metric="$1"
    local pool="$2"
    local extra_label="$3"
    local extra_value="$4"
    local value="$5"
    local tier role
    tier="$(pool_tier "$pool")"
    role="$(pool_role "$pool")"
    printf '%s{host="%s",zpool="%s",tier="%s",role="%s",%s="%s"} %s\n' \
        "$metric" "$HOST" "$pool" "$tier" "$role" "$extra_label" "$extra_value" "$value"
}

# Per-device state, which pool-level health does not cover. A raidz1 vdev with a
# FAULTED member still reports the pool as ONLINE via `zpool list`, so
# `homelab_zpool_healthy` stays 1 while the vdev has no redundancy left. That is
# not hypothetical: ace/vault-hdd lost a disk on 2026-08-09 and raised nothing.
#
# `zpool status -Pp` prints leaf vdevs as full /dev paths and container vdevs
# (raidz1-0, mirror-0) as bare names, so a leading slash identifies real devices
# without depending on indentation. -p keeps error counters unabbreviated.
write_pool_device_metrics() {
    local pool="$1"
    local total=0 unhealthy=0
    local name state read write cksum device

    while read -r name state read write cksum; do
        [[ "$name" == /* ]] || continue
        device="${name##*/}"
        device="${device%-part[0-9]*}"
        total=$((total + 1))
        [[ "$state" != "ONLINE" ]] && unhealthy=$((unhealthy + 1))
        write_device_state_info "$pool" "$device" "$state"
        write_device_errors "$pool" "$device" read "$read"
        write_device_errors "$pool" "$device" write "$write"
        write_device_errors "$pool" "$device" cksum "$cksum"
    done < <(zpool status -Pp "$pool" 2>/dev/null | awk '/^\t/ {print $1, $2, $3, $4, $5}')

    write_metric homelab_zpool_devices_total "$pool" "$total"
    write_metric homelab_zpool_devices_unhealthy "$pool" "$unhealthy"
}

write_device_state_info() {
    local pool="$1" device="$2" state="$3"
    local tier role
    tier="$(pool_tier "$pool")"
    role="$(pool_role "$pool")"
    printf 'homelab_zpool_device_state_info{host="%s",zpool="%s",tier="%s",role="%s",device="%s",state="%s"} 1\n' \
        "$HOST" "$pool" "$tier" "$role" "$device" "$state"
}

write_device_errors() {
    local pool="$1" device="$2" kind="$3" value="$4"
    [[ "$value" =~ ^[0-9]+$ ]] || return 0
    local tier role
    tier="$(pool_tier "$pool")"
    role="$(pool_role "$pool")"
    printf 'homelab_zpool_device_errors{host="%s",zpool="%s",tier="%s",role="%s",device="%s",type="%s"} %s\n' \
        "$HOST" "$pool" "$tier" "$role" "$device" "$kind" "$value"
}

{
    printf '# HELP homelab_zpool_size_bytes ZFS pool total size in bytes.\n'
    printf '# TYPE homelab_zpool_size_bytes gauge\n'
    printf '# HELP homelab_zpool_allocated_bytes ZFS pool allocated bytes.\n'
    printf '# TYPE homelab_zpool_allocated_bytes gauge\n'
    printf '# HELP homelab_zpool_free_bytes ZFS pool free bytes.\n'
    printf '# TYPE homelab_zpool_free_bytes gauge\n'
    printf '# HELP homelab_zpool_used_percent ZFS pool allocated percentage.\n'
    printf '# TYPE homelab_zpool_used_percent gauge\n'
    printf '# HELP homelab_zpool_healthy Whether the ZFS pool health state is ONLINE (1) or not (0). Pool level only: a raidz vdev with a faulted member can still report ONLINE, so alert on homelab_zpool_devices_unhealthy as well.\n'
    printf '# TYPE homelab_zpool_healthy gauge\n'
    printf '# HELP homelab_zpool_state_info ZFS pool health state as reported by zpool list, or MISSING when an expected pool is not imported; value is always 1, state is a label.\n'
    printf '# TYPE homelab_zpool_state_info gauge\n'
    printf '# HELP homelab_zpool_devices_total Number of leaf devices in the ZFS pool.\n'
    printf '# TYPE homelab_zpool_devices_total gauge\n'
    printf '# HELP homelab_zpool_devices_unhealthy Number of leaf devices whose state is not ONLINE.\n'
    printf '# TYPE homelab_zpool_devices_unhealthy gauge\n'
    printf '# HELP homelab_zpool_device_state_info ZFS leaf device state; value is always 1, state is a label.\n'
    printf '# TYPE homelab_zpool_device_state_info gauge\n'
    printf '# HELP homelab_zpool_device_errors ZFS per-device error counters as reported by zpool status.\n'
    printf '# TYPE homelab_zpool_device_errors gauge\n'

    # Process substitution rather than a pipe: a piped `while` runs in a subshell,
    # so seen_marker would not survive the loop.
    seen_marker=""
    while IFS=$'\t' read -r pool size alloc free health; do
        [[ -n "$pool" ]] || continue
        seen_marker+="|$pool|"
        used_percent="$(awk -v alloc="$alloc" -v size="$size" 'BEGIN { if (size > 0) printf "%.6f", (alloc / size) * 100; else printf "0" }')"
        healthy=0
        [[ "$health" == "ONLINE" ]] && healthy=1
        write_metric homelab_zpool_size_bytes "$pool" "$size"
        write_metric homelab_zpool_allocated_bytes "$pool" "$alloc"
        write_metric homelab_zpool_free_bytes "$pool" "$free"
        write_metric homelab_zpool_used_percent "$pool" "$used_percent"
        write_metric homelab_zpool_healthy "$pool" "$healthy"
        write_labeled_metric homelab_zpool_state_info "$pool" state "$health" 1
        write_pool_device_metrics "$pool"
    done < <(zpool list -Hp -o name,size,alloc,free,health)

    # Expected pools that never showed up in `zpool list`. Deliberately no
    # size/alloc/free here: there is no pool to measure. Label set matches the
    # imported case so the series keeps its identity across the transition.
    while IFS= read -r pool; do
        [[ -n "$pool" ]] || continue
        [[ "$seen_marker" == *"|$pool|"* ]] && continue
        write_metric homelab_zpool_healthy "$pool" 0
        write_labeled_metric homelab_zpool_state_info "$pool" state MISSING 1
    done < <(read_expected_pools)
} > "$TMP_FILE"

chmod 0644 "$TMP_FILE"
mv "$TMP_FILE" "$OUT_FILE"
trap - EXIT
