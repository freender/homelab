#!ipxe
# boot.ipxe - Safe top-level Homelab network boot menu
# Rendered by homelab deploy; do not edit manually.
# Defaults to local disk after 10 seconds.

set menu-timeout 10000
set menu-default local
set http-boot-server {{ MGMT_IP }}

:menu
menu Homelab Network Boot
item local           Boot local disk (default 10s)
item shell           iPXE shell
item reboot          Reboot
item pdm-auto        Proxmox VE automated install via PDM
item pve-tui         Proxmox VE terminal installer
item pve-gui         Proxmox VE graphical installer
item pve-debug       Proxmox VE debug installer
item pve-serial      Proxmox VE serial terminal installer
choose --timeout ${menu-timeout} --default ${menu-default} selected || goto local
goto ${selected}

:local
sanboot --no-describe --drive 0x80 || exit

:shell
shell
goto menu

:reboot
reboot

:pdm-auto
chain http://${http-boot-server}/pdm-auto-warning.ipxe

:pve-tui
chain http://${http-boot-server}/pve-tui.ipxe

:pve-gui
chain http://${http-boot-server}/pve-gui.ipxe

:pve-debug
chain http://${http-boot-server}/pve-debug.ipxe

:pve-serial
chain http://${http-boot-server}/pve-serial.ipxe
