#!/usr/bin/env bash
# iso-autobuild - Build baked PVE install ISOs for offsite hosts.
# Reads per-host answer TOML files from /etc/homelab-http-boot/iso-answers/<host>.toml.
# Outputs /srv/httpboot/iso/proxmox-ve-<host>-auto.iso (replaces previous).
# Called by pve-http-boot-autoupdate after a new base ISO is promoted; safe to run manually.
set -euo pipefail

ANSWER_DIR="/etc/homelab-http-boot/iso-answers"
ISO_BASE_DIR="/root/iso"
ISO_SERVE_DIR="/srv/httpboot/iso"
LOCK="/run/iso-autobuild.lock"

# No node_exporter textfile metric here: arc (this host) has no node_exporter
# installed/scraped (it's outside the pve-exporters host list), so a metric
# would just be written and never read. Failures surface via `systemctl status
# iso-autobuild`/journalctl (this is a oneshot unit; a failed run is visible as
# a failed unit) rather than a Prometheus alert. If alerting on this becomes
# worth having, wire it through a notify-on-failure unit instead of a dead
# textfile metric.
log()    { echo "iso-autobuild: $*"; }
fail()   { log "ERROR: $*" >&2; exit 1; }

# Prevent overlapping runs.
exec 9>"$LOCK"
flock -n 9 || { log "another run is active"; exit 0; }

# Ensure proxmox-auto-install-assistant is present.
if ! command -v proxmox-auto-install-assistant >/dev/null 2>&1; then
    log "proxmox-auto-install-assistant not found; installing..."
    apt-get install -y -qq proxmox-auto-install-assistant xorriso \
        || fail "could not install proxmox-auto-install-assistant"
fi

# Find latest base ISO.
latest_iso="$(ls -1t "$ISO_BASE_DIR"/proxmox-ve_*.iso 2>/dev/null | head -1)"
[[ -n "$latest_iso" ]] || fail "no base ISO found in $ISO_BASE_DIR; run pve-http-boot-autoupdate first"
log "base ISO: $(basename "$latest_iso")"

# Find answer files.
shopt -s nullglob
answer_files=("$ANSWER_DIR"/*.toml)
shopt -u nullglob
if [[ ${#answer_files[@]} -eq 0 ]]; then
    log "no answer files in $ANSWER_DIR; no baked ISOs to build"
    exit 0
fi

mkdir -p "$ISO_SERVE_DIR"

built=0
failed=0

for answer_file in "${answer_files[@]}"; do
    host="$(basename "$answer_file" .toml)"
    out_iso="$ISO_SERVE_DIR/proxmox-ve-${host}-auto.iso"
    tmp_iso="${out_iso}.tmp"

    log "building ISO for ${host}..."
    rm -f "$out_iso" "$tmp_iso"

    if proxmox-auto-install-assistant prepare-iso "$latest_iso" \
        --fetch-from iso \
        --answer-file "$answer_file" \
        --output "$tmp_iso" 2>&1 | sed "s/^/  [${host}] /"; then
        mv "$tmp_iso" "$out_iso"
        log "  done: $(basename "$out_iso") ($(du -sh "$out_iso" | cut -f1))"
        (( built++ )) || true
    else
        rm -f "$tmp_iso"
        log "ERROR: ISO build failed for ${host}"
        (( failed++ )) || true
    fi
done

if [[ "$failed" -gt 0 ]]; then
    log "completed with errors: ${built} built, ${failed} failed"
    exit 1
fi

log "all done: ${built} ISO(s) built in $ISO_SERVE_DIR"
