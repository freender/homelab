#!/usr/bin/env bash
# pve-http-boot-disable - HTTP Boot is controlled by UniFi Network Boot settings.
# nginx is kept running to serve /httpboot, /boot.ipxe, payloads, and baked ISOs.
# Safe to run multiple times; idempotent.
set -euo pipefail

systemctl start nginx

echo "pve-http-boot-disable: no local HTTP Boot service to stop; disable UniFi Network Boot if needed"
