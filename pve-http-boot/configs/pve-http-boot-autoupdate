#!/usr/bin/env bash
# pve-http-boot-autoupdate - Detect, build, validate, and atomically promote a new Proxmox VE HTTP Boot payload.
# Reads the PDM answer-auth token from TOKEN_FILE; never prints it.
set -euo pipefail

ISO_INDEX="https://enterprise.proxmox.com/iso/"
ISO_DIR="/root/iso"
SRV="/srv/httpboot"
STAGE="/srv/httpboot.stage"
HTTP_BOOT_BUILD="$ISO_DIR/http-boot-build"
TOKEN_FILE="/root/homelab-pve-auto-install.token"
LOCK="/run/pve-http-boot-autoupdate.lock"

# PDM connection details (written by homelab deploy; do not edit here)
# shellcheck source=/etc/homelab-http-boot/http-boot-mgmt.conf
source /etc/homelab-http-boot/http-boot-mgmt.conf

log()    { echo "pve-http-boot-autoupdate: $*"; }
# No node_exporter textfile metric here: arc (this host) has no node_exporter
# installed/scraped (it's outside the metrics-exporters host list), so a metric
# would just be written and never read. Failures surface via `systemctl status
# pve-http-boot-autoupdate`/journalctl (this is a oneshot unit; a failed run is
# visible as a failed unit) rather than a Prometheus alert. If alerting on this
# becomes worth having, wire it through a notify-on-failure unit instead of a
# dead textfile metric.
fail()   { log "ERROR: $*" >&2; exit 1; }

cleanup_temp() {
    rm -rf "$STAGE" "$HTTP_BOOT_BUILD"
}
trap cleanup_temp EXIT

# Prevent overlapping runs
exec 9>"$LOCK"
flock -n 9 || { log "another run is active"; exit 0; }

# 1. Detect latest upstream ISO
latest="$(curl -fsSL "$ISO_INDEX" | grep -oE "proxmox-ve_[0-9]+\.[0-9]+-[0-9]+\.iso" | sort -V | tail -1)"
[[ -n "$latest" ]] || fail "could not determine latest upstream ISO"

staged="$(
    find "$SRV" -maxdepth 1 -name 'proxmox-ve_*.iso' -printf '%f\n' 2>/dev/null \
        | sed -E 's/-auto-[^.]+\.iso$/.iso/' \
        | sort -V \
        | tail -1
)"
if [[ "$latest" == "$staged" ]]; then
    log "up to date ($staged)"
    exit 0
fi
log "new ISO $latest (staged: ${staged:-none}); rebuilding payload"

# 2. Download + verify new ISO
mkdir -p "$ISO_DIR"
cd "$ISO_DIR"
curl -fLO "${ISO_INDEX}${latest}"
if curl -fsSL "${ISO_INDEX}${latest}.sha256sum" -o "${latest}.sha256sum" 2>/dev/null; then
    grep -E "  ?${latest}\$" "${latest}.sha256sum" | sha256sum -c - \
        || log "WARN: sha256sum mismatch — proceeding with caution"
else
    log "WARN: no upstream sha256sum available"
fi

# 3. Build prepared HTTP Boot payload
command -v proxmox-auto-install-assistant >/dev/null \
    || apt-get install -y proxmox-auto-install-assistant xorriso >/dev/null
[[ -s "$TOKEN_FILE" ]] || fail "missing or empty token file $TOKEN_FILE"

rm -rf "$HTTP_BOOT_BUILD"
mkdir -p "$HTTP_BOOT_BUILD"
proxmox-auto-install-assistant prepare-iso "$ISO_DIR/$latest" \
    --pxe --pxe-loader ipxe --fetch-from http \
    --url "$PDM_URL" \
    --cert-fingerprint "$PDM_CERT_FINGERPRINT" \
    --answer-auth-token "$(cat "$TOKEN_FILE")" \
    --output "$HTTP_BOOT_BUILD" >/dev/null

[[ -s "$HTTP_BOOT_BUILD/vmlinuz" && -s "$HTTP_BOOT_BUILD/initrd.img" ]] \
    || fail "prepare-iso did not produce vmlinuz/initrd.img"
prepared_iso="$(find "$HTTP_BOOT_BUILD" -maxdepth 1 -name 'proxmox-ve_*.iso' -printf '%f\n' 2>/dev/null | sort -V | tail -1)"
[[ -n "$prepared_iso" && -s "$HTTP_BOOT_BUILD/$prepared_iso" ]] \
    || fail "prepare-iso did not produce prepared Proxmox ISO"

# 4. Assemble staging copy with new payload + version-bumped loaders
ver="${latest%.iso}"
ver="${ver#proxmox-ve_}"
rm -rf "$STAGE"
mkdir -p "$STAGE"
rsync -a --exclude '/iso/' "$SRV"/ "$STAGE"/
rm -f "$STAGE"/proxmox-ve_*.iso
install -m 0644 "$HTTP_BOOT_BUILD/vmlinuz"    "$STAGE/vmlinuz"
install -m 0644 "$HTTP_BOOT_BUILD/initrd.img" "$STAGE/initrd.img"
install -m 0644 "$HTTP_BOOT_BUILD/$prepared_iso" "$STAGE/$prepared_iso"
# iPXE menus resolve the server at runtime via ${http-boot-server} (set in the entry
# points by homelab deploy), so the only per-version rewrite is the ISO filename.
sed -i -E \
    -e "s#proxmox-ve_[^[:space:]]+\.iso#${prepared_iso}#g" \
    "$STAGE/pve-load.ipxe"

# 5. Validate staged payload consistency
grep -q "${prepared_iso}" "$STAGE/pve-load.ipxe" \
    || fail "pve-load.ipxe not pointing at ${prepared_iso}"
if grep -R "PLACEHOLDER" "$STAGE"/*.ipxe >/dev/null; then
    fail "staged iPXE scripts still contain placeholder ISO references"
fi
for f in vmlinuz initrd.img "$prepared_iso" boot.ipxe pve-load.ipxe pdm-auto.ipxe; do
    [[ -s "$STAGE/$f" ]] || fail "staged payload missing $f"
done

# 6. Atomically promote: keep rollback copy, swap dirs, reload nginx
need_disable=0
systemctl is-active --quiet nginx || { /usr/local/sbin/pve-http-boot-enable; need_disable=1; }
rm -rf "$SRV.prev"
mkdir -p "$SRV.prev"
rsync -a --exclude '/iso/' "$SRV"/ "$SRV.prev"/
rsync -a --delete --exclude '/iso/' "$STAGE"/ "$SRV"/
systemctl reload nginx 2>/dev/null || systemctl restart nginx

# 7. Post-promote HTTP smoke test
ok=1
curl -fsI "http://127.0.0.1/$prepared_iso" >/dev/null || ok=0
curl -fsI "http://127.0.0.1/initrd.img" >/dev/null || ok=0
curl -fsI "http://127.0.0.1/boot.ipxe"  >/dev/null || ok=0
if [[ "$ok" -ne 1 ]]; then
    log "post-promote check failed; rolling back"
    rsync -a --delete --exclude '/iso/' "$SRV.prev"/ "$SRV"/
    systemctl reload nginx 2>/dev/null || systemctl restart nginx
    [[ "$need_disable" -eq 1 ]] && /usr/local/sbin/pve-http-boot-disable || true
    fail "rolled back to previous payload"
fi

# 8. Rebuild baked offsite ISOs from the newly promoted base ISO.
if command -v iso-autobuild >/dev/null 2>&1; then
    iso-autobuild || fail "baked ISO rebuild failed"
else
    log "WARN: iso-autobuild not installed; baked ISO rebuild skipped"
fi

# 9. Clean up: keep current + one previous ISO in /root/iso
ls -1t "$ISO_DIR"/proxmox-ve_*.iso 2>/dev/null | tail -n +3 | xargs -r rm -f
[[ "$need_disable" -eq 1 ]] && /usr/local/sbin/pve-http-boot-disable || true

log "promoted proxmox-ve_${ver}"
