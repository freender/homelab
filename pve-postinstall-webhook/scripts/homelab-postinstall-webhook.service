[Unit]
Description=Homelab Proxmox post-install webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/homelab-postinstall-webhook/env
ExecStart=/usr/local/sbin/homelab-postinstall-webhook
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
