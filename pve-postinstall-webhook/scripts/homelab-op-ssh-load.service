[Unit]
Description=Load homelab SSH keys from 1Password
After=network-online.target homelab-ssh-agent.service
Wants=network-online.target homelab-ssh-agent.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=SSH_AUTH_SOCK=/root/.ssh/agent.sock
ExecStartPre=/bin/sh -c 'i=0; while [ ! -S "$SSH_AUTH_SOCK" ] && [ "$i" -lt 40 ]; do i=$((i + 1)); sleep 0.25; done; [ -S "$SSH_AUTH_SOCK" ]'
ExecStart=/root/.local/bin/addhomelabkeys
