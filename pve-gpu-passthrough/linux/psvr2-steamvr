#!/usr/bin/env bash
# Start the VR runtime when the PS VR2 headset powers on (solar, freender/homelab-ops#389).
# Run by psvr2-steamvr.service, which 71-psvr2-steamvr.rules starts. The headset
# re-enumerates while it powers up, so repeat triggers are dropped while a runtime
# runs or within COOLDOWN seconds of the last launch.
# The runtime is SteamVR unless psvr2-runtime selected Monado (Envision profile).
set -euo pipefail

STEAMVR_APPID=250820
ENVISION_PROFILE=psvr2-toolkit-monado
COOLDOWN=60
SETTLE=3

runtime=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/psvr2/runtime" 2>/dev/null || echo steamvr)
state="${XDG_RUNTIME_DIR:-/tmp}/psvr2-steamvr"
exec 9>"$state.lock"
flock -n 9 || exit 0

for proc in vrserver vrcompositor monado-service; do
    if pgrep -u "$UID" -x "$proc" >/dev/null; then
        echo "$proc already running"
        exit 0
    fi
done

now=$(date +%s)
last=$(cat "$state.last" 2>/dev/null || echo 0)
if (( now - last < COOLDOWN )); then
    echo "runtime launched $(( now - last ))s ago, skipping"
    exit 0
fi
echo "$now" >"$state.last"

sleep "$SETTLE"
# Each runtime gets its own transient unit so it outlives this oneshot's cgroup
# (if Steam was not already running, this `steam` becomes the Steam client).
case "$runtime" in
    monado)
        echo "starting Monado (Envision profile $ENVISION_PROFILE)"
        systemd-run --user --collect --no-block --quiet "$HOME/.local/bin/envision" -p "$ENVISION_PROFILE" -S
        ;;
    *)
        echo "starting SteamVR"
        systemd-run --user --collect --no-block --quiet steam "steam://rungameid/$STEAMVR_APPID"
        ;;
esac
