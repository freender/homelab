#!/usr/bin/env bash
# Start SteamVR when the PS VR2 headset powers on (solar, freender/homelab-ops#389).
# Run by psvr2-steamvr.service, which 71-psvr2-steamvr.rules starts. The headset
# re-enumerates while it powers up, so repeat triggers are dropped while SteamVR
# runs or within COOLDOWN seconds of the last launch.
set -euo pipefail

STEAMVR_APPID=250820
COOLDOWN=60
SETTLE=3

state="${XDG_RUNTIME_DIR:-/tmp}/psvr2-steamvr"
exec 9>"$state.lock"
flock -n 9 || exit 0

if pgrep -u "$UID" -x vrserver >/dev/null || pgrep -u "$UID" -x vrcompositor >/dev/null; then
    echo "SteamVR already running"
    exit 0
fi

now=$(date +%s)
last=$(cat "$state.last" 2>/dev/null || echo 0)
if (( now - last < COOLDOWN )); then
    echo "SteamVR launched $(( now - last ))s ago, skipping"
    exit 0
fi
echo "$now" >"$state.last"

sleep "$SETTLE"
echo "starting SteamVR"
# Its own transient unit: if Steam was not already running, this `steam` becomes
# the Steam client, which must outlive this oneshot's cgroup.
systemd-run --user --collect --no-block --quiet steam "steam://rungameid/$STEAMVR_APPID"
