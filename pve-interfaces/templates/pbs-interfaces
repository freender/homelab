auto lo
iface lo inet loopback

iface nic0 inet manual

auto vmbr0
iface vmbr0 inet static
    address ${NET_MGMT_IP}
    gateway ${NET_GATEWAY}
    bridge-ports nic0
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 2-4094

# Load additional interface configs
source /etc/network/interfaces.d/*
